executable = run_pbpb_26_mindR_0_01.sh
arguments = $(Process)
output = logs/run_pbpb_26_mindR_0_01_batch_$(Process).out
error = logs/run_pbpb_26_mindR_0_01_batch_$(Process).err
log = logs/run_pbpb_26_mindR_0_01_batch_$(Process).log
request_memory = 2GB
# queue N = part count on disk; keep equal to file_batch_max{26} in PbPbExtras.c
# (preflight_pbpb_year.sh 26 cross-checks). Too few SILENTLY drops data.
queue 7
