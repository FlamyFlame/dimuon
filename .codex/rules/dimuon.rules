# Project rules supplement hooks; restrictive matches win.

prefix_rule(
    pattern = ["pip", "install"],
    decision = "forbidden",
    justification = "Use the configured analysis release/runtime; do not install packages.",
    match = ["pip install uproot"],
)

prefix_rule(
    pattern = ["pip3", "install"],
    decision = "forbidden",
    justification = "Use the configured analysis release/runtime; do not install packages.",
    match = ["pip3 install numpy"],
)

prefix_rule(
    pattern = [["python", "python3"], "-m", "pip", "install"],
    decision = "forbidden",
    justification = "Use the configured analysis release/runtime; do not install packages.",
    match = ["python -m pip install uproot", "python3 -m pip install uproot"],
)

prefix_rule(
    pattern = ["voms-proxy-init"],
    decision = "forbidden",
    justification = "The user must initialize credentials interactively.",
    match = ["voms-proxy-init -voms atlas"],
)

prefix_rule(
    pattern = ["git", "add", [".", "-A", "--all"]],
    decision = "forbidden",
    justification = "Stage explicit logical file groups to preserve unrelated changes.",
    match = ["git add .", "git add -A", "git add --all"],
    not_match = ["git add AGENTS.md"],
)

prefix_rule(
    pattern = ["git", ["commit", "push"]],
    decision = "prompt",
    justification = "Committing and pushing require explicit task authorization.",
    match = ["git commit -m update", "git push origin feature"],
)

prefix_rule(
    pattern = [["rucio", "pbook", "pathena", "prun", "condor_submit"]],
    decision = "prompt",
    justification = "Remote data, grid, and batch state changes require review.",
    match = ["rucio add-rule scope:name 1 BNL-OSSG2_DATADISK", "pbook kill 123", "pathena job.py", "condor_submit run.sub"],
)
